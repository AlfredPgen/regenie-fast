#!/bin/bash
# Launcher for regenie 4.1.3-fast. Runs it with the system libraries and loader bundled in lib/, so it also works
# where the cluster's own libraries are older (e.g. RHEL/Rocky 8) or missing (OpenSSL 3, libgfortran5).
# LD_PRELOAD is cleared for this program only: a monitoring library the cluster preloads (e.g. XALT, Darshan) is
# built for the cluster's own system libraries and would stop the bundled ones from starting.
unset LD_PRELOAD
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
exec "$DIR/lib/ld-linux-x86-64.so.2" --library-path "$DIR/lib" "$DIR/bin/regenie-4.1.3-fast" "$@"
